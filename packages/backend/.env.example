# UniDoc Backend Environment Configuration
# Copy this file to .env and fill in the values

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
# The AI agent requires this key. Without it, the deterministic API still works.
GEMINI_API_KEY=

# Gemini Model (optional, defaults to gemini-1.5-flash)
# Free tier models: gemini-1.5-flash, gemini-1.5-flash-8b
# Subject to Google's free tier quotas and eligibility
GEMINI_MODEL=gemini-1.5-flash

# Backend Port (optional, defaults to 3001)
PORT=3001
