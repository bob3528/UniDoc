# UniDoc Backend Environment Configuration
# Copy this file to packages/backend/.env and fill in the values

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
# The AI agent requires this key. Without it, the deterministic API still works.
GEMINI_API_KEY=

# Gemini Model (optional, defaults to gemini-2.5-flash)
# Example models (availability depends on your account): gemini-2.5-flash, gemini-2.5-flash-lite
# Subject to Google's free tier quotas and eligibility
GEMINI_MODEL=gemini-2.5-flash

# Fallback model used when the primary model returns 503/429 after retries.
# Defaults to gemini-2.0-flash (older generation, more serving capacity, cost-efficient).
# Set to empty string to disable fallback.
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Base backoff delay in ms for exponential retry on 503/429 (optional, default 1000)
# Actual delay respects the Retry-After header when present.
GEMINI_BASE_BACKOFF_MS=1000

# Backend Port (optional, defaults to 3001)
PORT=3001
